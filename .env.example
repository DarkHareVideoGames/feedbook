# Copiar este ficheiro para ".env" e preencher com os valores do projeto Supabase
# (Project Settings → API no painel do Supabase)

# Ex.: https://abcdefghij.supabase.co
VITE_SUPABASE_URL=

# Chave anon/pública (safe para o browser)
VITE_SUPABASE_ANON_KEY=

# Email do administrador root (Superuser). Quem usar este email entra
# sempre como superuser. Definir por ambiente para não versionar um
# endereço pessoal; sem valor, o código usa o fallback em src/api.ts.
VITE_SUPERUSER_EMAIL=

# --- SMTP próprio (servidor de notificações /api/notify) ---
SMTP_HOST=mail.feedbackproductions.pt
SMTP_PORT=465
SMTP_USER=ensaios@feedbackproductions.pt
# Palavra-passe da conta (nunca commitar valores reais)
SMTP_PASS=
SMTP_FROM=Feedback - Ensaios <ensaios@feedbackproductions.pt>
# 465 = SSL/TLS direto; 587 = STARTTLS (SMTP_SECURE segue a porta por omissão)
SMTP_SECURE=

# Webhook do Discord para alertas de novas marcações (canal #marcação-de-ensaios)
# (nunca commitar o URL real)
DISCORD_WEBHOOK_URL=

# --- Operações servidoras seguras (/api/user-invite, /api/create-booking) ---
# Nota: localmente as VITE_ de cima são usadas como fallback de SUPABASE_URL/anon key.
# Service role key do Supabase (Settings → API). É obrigatória nas rotas
# /api/user-invite e /api/create-booking; SOMENTE no servidor.
# SOMENTE para o servidor — NUNCA usar prefixo VITE_ (iria para o bundle do browser).
SUPABASE_SERVICE_ROLE_KEY=
# URL base da app para onde o link "define a password" redireciona.
# Tem de estar na allow-list do Supabase (Authentication → URL Configuration → Redirect URLs).
# Local: http://localhost:5173 | Produção: https://feedbook-kappa.vercel.app
APP_BASE_URL=http://localhost:5173
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@feedbackproductions.pt
